&lt;text x="40" y="100" class="node-text-fade" dy=".3em">u₄&lt;/text>
&lt;circle cx="220" cy="40" r="16" fill="url(#fadedGrad)" stroke="#D1D5DB" stroke-width="1" />
&lt;text x="220" y="40" class="node-text-fade" dy=".3em">u₅&lt;/text>
&lt;!-- Sampled Neighbors -->
&lt;circle cx="60" cy="160" r="18" fill="url(#sampledGrad)" filter="url(#shadow)" />
&lt;text x="60" y="160" class="node-text" dy=".3em">u₁&lt;/text>
&lt;circle cx="180" cy="160" r="18" fill="url(#sampledGrad)" filter="url(#shadow)" />
&lt;text x="180" y="160" class="node-text" dy=".3em">u₂&lt;/text>
&lt;!-- Target Node -->
&lt;circle cx="120" cy="120" r="26" fill="url(#targetGrad)" filter="url(#shadow)" stroke="#B91C1C" stroke-width="1.5" />
